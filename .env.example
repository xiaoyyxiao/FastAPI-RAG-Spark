# 应用基础信息
APP_TITLE=FastAPI RAG Spark
APP_VERSION=1.0.0

# 安全配置
SECRET_KEY=change-this-secret-key

# 鉴权配置
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 讯飞 Spark 配置
XF_APPID=your-appid
XF_APIKey=your-api-key
XF_APISecret=your-api-secret
XF_DOMAIN=lite
XF_MODEL=lite
XF_URL=https://spark-api-open.xf-yun.com/v1/chat/completions

# 模型路由配置
LLM_PRIMARY_PROVIDER=spark
LLM_FALLBACK_PROVIDER=mock
LLM_REQUEST_TIMEOUT_SECONDS=30

# Embedding 配置
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh

# 文档上传限制
MAX_FILE_SIZE=10485760

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EXPIRE_SECONDS=600
REDIS_SSL=false
